{
  "name": "whatsmyip",
  "version": "3.4.4",
  "description": "A simple service to display your external IP address with geolocation information",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "download-geodata": "bash scripts/download-geodata.sh",
    "lint": "eslint server.js src/ tests/ public/"
  },
  "keywords": [
    "ip",
    "geolocation",
    "whatsmyip"
  ],
  "author": "Paul Git",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "flag-icons": "^7.5.0",
    "ip2location-nodejs": "^9.7.0"
  },
  "overrides": {
    "qs": "^6.15.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "vitest": "^4.1.6"
  }
}
