# What's My IP - Environment Configuration
# Copy this file to .env and fill in your values

# Application
NODE_ENV=production
PORT=3000

# IP2Location LITE Download Token (required for geolocation)
# Get your free token at https://lite.ip2location.com
IP2LOCATION_TOKEN=your_token_here

# How often to refresh the geolocation databases at runtime (hours, 0 = disabled)
# IP2Location LITE databases are updated monthly; 168 (weekly) is a reasonable default
# GEODATA_REFRESH_HOURS=168

# Development: override the detected IP address (useful when running locally)
# DEV_IP=8.8.8.8
